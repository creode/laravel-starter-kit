includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/tomasvotruba/type-coverage/config/extension.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:

    paths:
        - app
        - app-modules
        - bootstrap/app.php
        - config
        - database
        - public
        - routes


    level: max

    type_coverage:
        return: 100
        param: 100
        property: 100
        constant: 100

    excludePaths:
        analyse:
            - app-modules/*/tests

    tmpDir: /tmp/phpstan
